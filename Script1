local function getQueueOnTeleport()
    if type(queue_on_teleport) == "function" then return queue_on_teleport end
    if type(queueonteleport)   == "function" then return queueonteleport end
    local env = (type(getgenv) == "function" and getgenv()) or _G
    if env then
        if type(env.queue_on_teleport) == "function" then return env.queue_on_teleport end
        if type(env.queueonteleport)   == "function" then return env.queueonteleport end
    end
    if type(syn)    == "table" and type(syn.queue_on_teleport)    == "function" then return syn.queue_on_teleport end
    if type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" then return fluxus.queue_on_teleport end
    if type(krnl)   == "table" and type(krnl.queue_on_teleport)   == "function" then return krnl.queue_on_teleport end
    return nil
end

local function queueAutoRejoin()
    local q = getQueueOnTeleport()
    if not q then return false end
    if SERAPHINA_REJOIN_URL ~= "" then
        local loader = string.format([[
            local url = %q
            local ok, src = pcall(function() return game:HttpGet(url, true) end)
            if ok and src then loadstring(src)() end
        ]], SERAPHINA_REJOIN_URL)
        pcall(q, loader)
    end
end

local STOP_WAVE         = 47
local SKIP_COOLDOWN     = 0.5
local POLL_INTERVAL     = 0.1
local DISCOVER_COOLDOWN = 2

local seraphinaAutoSkipEnabled = true
local currentWave     = 0
local reachedEnd      = false
local lastSkipTime    = 0
local skipRemote      = nil
local waveSource      = nil
local lastDiscover    = 0

local function findSkipRemote()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name:lower():find("skip", 1, true) then return obj end
    end
    return nil
end

local function discoverWaveSource()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if (obj:IsA("IntValue") or obj:IsA("NumberValue")) and obj.Name:lower():find("wave", 1, true) then
            return { kind = "value", obj = obj }
        end
    end
    for _, name in ipairs({"Wave", "wave", "CurrentWave", "currentWave", "Current_Wave", "WaveNumber"}) do
        local v = Workspace:GetAttribute(name)
        if type(v) == "number" then return { kind = "attribute", name = name } end
    end
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in ipairs(pg:GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Text and obj.Text:match("[Ww]ave%s*[:%-]?%s*%d+") then
                return { kind = "label", obj = obj }
            end
        end
    end
    return nil
end

local function readWave()
    if not waveSource then
        if os.clock() - lastDiscover < DISCOVER_COOLDOWN then return nil end
        lastDiscover = os.clock()
        waveSource = discoverWaveSource()
        if not waveSource then return nil end
    end
    if waveSource.kind == "value" then
        if not waveSource.obj or not waveSource.obj.Parent then waveSource = nil; return nil end
        return math.floor(waveSource.obj.Value)
    elseif waveSource.kind == "attribute" then
        local v = Workspace:GetAttribute(waveSource.name)
        if type(v) ~= "number" then waveSource = nil; return nil end
        return math.floor(v)
    elseif waveSource.kind == "label" then
        if not waveSource.obj or not waveSource.obj.Parent then waveSource = nil; return nil end
        local n = waveSource.obj.Text:match("[Ww]ave%s*[:%-]?%s*(%d+)")
        return n and tonumber(n) or nil
    end
end

local function fireSkip()
    if not skipRemote or not skipRemote.Parent then skipRemote = findSkipRemote() end
    if not skipRemote then return end
    pcall(function() skipRemote:FireServer() end)
end

task.spawn(function()
    while true do
        task.wait(POLL_INTERVAL)
        if _G.SeraphinaDeadScript then return end
        if not skipRemote then skipRemote = findSkipRemote() end

        local wave = readWave()
        if wave and wave ~= currentWave then currentWave = wave end

        if currentWave >= STOP_WAVE and not reachedEnd then
            reachedEnd = true
            print("[Seraphina] Reached wave " .. STOP_WAVE .. " — auto-skip halted permanently")
        end

        if seraphinaAutoSkipEnabled and not reachedEnd and skipRemote and currentWave >= 1 and currentWave < STOP_WAVE and os.clock() - lastSkipTime >= SKIP_COOLDOWN then
            fireSkip()
            lastSkipTime = os.clock()
        end
    end
end)

