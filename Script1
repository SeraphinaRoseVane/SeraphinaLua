local oldGui = CoreGui:FindFirstChild("Seraphina_AutoPlayAgain")
if oldGui then oldGui:Destroy() end
if _G.Seraphina_AutoPlayAgain then _G.Seraphina_AutoPlayAgain = false end
_G.Seraphina_AutoPlayAgain = true

local GuiService = game:GetService("GuiService")
local enabled = true
local lastClickAt = 0
local lastClickedButton = nil

local function norm(t)
    if type(t) ~= "string" then return "" end
    return (t:lower():gsub("%s+", " "):match("^%s*(.-)%s*$")) or ""
end

local function findPlayAgainButton()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local finalUI = pg:FindFirstChild("GameUI") and pg.GameUI:FindFirstChild("FinalUI")
    if not finalUI or not finalUI.Visible then return nil end
    for _, obj in ipairs(finalUI:GetDescendants()) do
        if obj:IsA("TextButton") then
            local txt = norm(obj.Text)
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("TextLabel") then txt = txt .. " " .. norm(d.Text) end
            end
            if txt:find("play again") then return obj end
        end
    end
    return nil
end

