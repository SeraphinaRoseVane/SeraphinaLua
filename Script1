local function parseInputLog(logStr)
    local out = {}
    if not logStr or logStr == "" then return out end
    for line in logStr:gmatch("[^\r\n]+") do
        local clean = line:gsub("^%s+", ""):gsub("%s+$", "")
        if clean ~= "" and not clean:match("^[Ww][Aa][Vv][Ee]") then
            local m, s, c = clean:match("(%d+):(%d+)%.(%d+)%s*$")
            if m then
                local t = tonumber(m) * 60 + tonumber(s) + tonumber(c) / 100
                local entry = nil
                if clean:find("XY", 1, true) then
                    local x, y = clean:match("(%d+),(%d+)")
                    if x and y then entry = {time = t, type = "click", x = tonumber(x), y = tonumber(y)} end
                elseif clean:find("@", 1, true) then
                    local x, y = clean:match("(%d+),(%d+)")
                    if x and y then entry = {time = t, type = "move", x = tonumber(x), y = tonumber(y)} end
                else
                    local k = clean:match("%[([%w])%]")
                    if k then entry = {time = t, type = "key", key = k} end
                end
                if entry then table.insert(out, entry) end
            end
        end
    end
    return out
end

local numKeyMap = { ["0"] = Enum.KeyCode.Zero, ["1"] = Enum.KeyCode.One, ["2"] = Enum.KeyCode.Two, ["3"] = Enum.KeyCode.Three, ["4"] = Enum.KeyCode.Four, ["5"] = Enum.KeyCode.Five, ["6"] = Enum.KeyCode.Six, ["7"] = Enum.KeyCode.Seven, ["8"] = Enum.KeyCode.Eight, ["9"] = Enum.KeyCode.Nine }
local function keyToEnum(k)
    if not k then return nil end
    if numKeyMap[k] then return numKeyMap[k] end
    local ok, kc = pcall(function() return Enum.KeyCode[k:upper()] end)
    if ok then return kc end
    return nil
end

local parsedInputs   = {}
local replayStarted  = false
local started        = false

local function runReplay()
    if #parsedInputs == 0 then return end
    task.spawn(function()
        local startClock = os.clock()
        for i, entry in ipairs(parsedInputs) do
            if _G.SeraphinaDeadScript then return end
            local remaining = entry.time - (os.clock() - startClock)
            if remaining > 0 then
                while remaining > 0.05 do
                    if _G.SeraphinaDeadScript then return end
                    task.wait(math.min(remaining, 0.5))
                    remaining = entry.time - (os.clock() - startClock)
                end
                if remaining > 0 then task.wait(remaining) end
            end
            if _G.SeraphinaDeadScript then return end
            pcall(function()
                if entry.type == "move" then VirtualInputManager:SendMouseMoveEvent(entry.x, entry.y, game)
                elseif entry.type == "click" then
                    VirtualInputManager:SendMouseButtonEvent(entry.x, entry.y, 0, true, game, 1)
                    task.delay(0.02, function() pcall(function() VirtualInputManager:SendMouseButtonEvent(entry.x, entry.y, 0, false, game, 1) end) end)
                elseif entry.type == "key" then
                    local kc = keyToEnum(entry.key)
                    if kc then
                        VirtualInputManager:SendKeyEvent(true, kc, false, game)
                        task.delay(0.02, function() pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end) end)
                    end
                end
            end)
        end
    end)
end

task.spawn(function()
    while not started do task.wait(0.1) end
    while not replayStarted do
        if _G.SeraphinaDeadScript then return end
        if readWave() == 1 then replayStarted = true; task.spawn(runReplay); return end
        task.wait(0.2)
    end
end)

